--- a/PKGBUILD
+++ b/PKGBUILD
@@ -8,7 +8,7 @@
 # Derive the upstream version (YYYY.MM.DD-<hash>) from that pkgver.
 _upstream_ver="${pkgver%.*}"
 _upstream_ver="${_upstream_ver%.*}-${pkgver##*.}"
-pkgrel=1
+pkgrel=1.1
 # epoch=1: bumped when switching from the original `20250808.0.<sha>` scheme
 # to the current `YYYY.MM.DD.<n>.<hash>` scheme (2025-08-09). Never decrease.
 epoch=1
@@ -42,6 +42,17 @@
     # bundled node and rg runtimes).
     cp -r "${srcdir}"/dist-package/* "${pkgdir}/opt/cursor-agent/"
 
+    if [[ $CARCH == aarch64 ]]; then
+        local tree_sitter_bash="${pkgdir}/opt/cursor-agent/node_modules/tree-sitter-bash"
+        [[ -f "${tree_sitter_bash}/build/Release/tree_sitter_bash_binding.node" ]] || {
+            error "Cursor's ARM64 archive lacks its native tree-sitter-bash binding"
+            return 1
+        }
+        # The ARM64 vendor archive also bundles x86_64, Windows, and macOS
+        # prebuilds. Node uses the native build/Release binding above on ARM.
+        rm -rf -- "${tree_sitter_bash}/prebuilds"
+    fi
+
     # Create symlink in /usr/bin
     ln -s "/opt/cursor-agent/cursor-agent" "${pkgdir}/usr/bin/cursor-agent"
 
