# Maintainer: David Heinemeier Hansson <david@hey.com>

pkgname=herdr
pkgver=0.8.0.r13
pkgrel=2
pkgdesc="Herdr terminal workspace manager built from the Omarchy fork"
arch=('x86_64' 'aarch64')
url="https://github.com/omacom-io/herdr"
license=('Apache-2.0')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
replaces=('omarchy-herdr')
conflicts=('omarchy-herdr')
options=('!debug' '!lto')

_commit=0766aa57ee0ceb4410ae064e94c0f0557853eee7
_zigver=0.15.2
source=("herdr-$_commit.tar.gz::$url/archive/$_commit.tar.gz")
source_x86_64=("zig-x86_64-linux-$_zigver.tar.xz::https://ziglang.org/download/$_zigver/zig-x86_64-linux-$_zigver.tar.xz")
source_aarch64=("zig-aarch64-linux-$_zigver.tar.xz::https://ziglang.org/download/$_zigver/zig-aarch64-linux-$_zigver.tar.xz")
sha256sums=('61d33624fd3af77ccf695d20c3c31689a44f8c2dc3855edd405eec7bc1af0318')
sha256sums_x86_64=('02aa270f183da276e5b5920b1dac44a63f1a49e55050ebde3aecc9eb82f93239')
sha256sums_aarch64=('958ed7d1e00d0ea76590d27666efbf7a932281b3d7ba0c6b01b0ff26498f667f')

prepare() {
  cd "herdr-$_commit"

  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "herdr-$_commit"

  export CARGO_TARGET_DIR=target
  export ZIG="$srcdir/zig-$CARCH-linux-$_zigver/zig"
  export ZIG_GLOBAL_CACHE_DIR="$srcdir/zig-cache"
  # The fork speaks protocol 20 while Cargo.toml still says 0.8.0, so an unmarked build is
  # indistinguishable from upstream's protocol-19 v0.8.0 that carries the same version string.
  export HERDR_BUILD_CHANNEL=omarchy
  export HERDR_BUILD_ID="${pkgver##*.}"
  cargo build --frozen --release
}

package() {
  cd "herdr-$_commit"

  install -Dm755 target/release/herdr "$pkgdir/usr/bin/herdr"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
