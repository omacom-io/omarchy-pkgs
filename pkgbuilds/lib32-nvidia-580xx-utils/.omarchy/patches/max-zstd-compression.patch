--- a/PKGBUILD
+++ b/PKGBUILD
@@ -12,6 +12,12 @@
 #makedepends=('nvidia-libgl')  # To avoid conflict during installation in the build chroot
 license=('custom')
 options=('!strip')
+
+# Omarchy: the build image compresses with zstd at its default level, which
+# leaves these unstripped driver blobs far larger than they need to be. Maximum
+# zstd saves 25 MB here, most of it on the ISO's offline mirror.
+COMPRESSZST=(zstd -c -z -q --ultra -22 --threads=0 -)
+
 _pkg="NVIDIA-Linux-x86_64-${pkgver}"
 source=("https://download.nvidia.com/XFree86/Linux-x86_64/${pkgver}/${_pkg}.run")
 sha512sums=('ca394b1e3f6c3403dc7ffe5d5fd7301bb06607fdbf75c9ffd338d7641c06d1878790c629108162adf4289ae829568973a48b7557183dbf7588e668f6d8edf3b3')
