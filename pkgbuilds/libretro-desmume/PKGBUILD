pkgname=libretro-desmume
pkgver=20260516.000420.gae0f7f51f96d
pkgrel=1
pkgdesc='Nintendo DS core'
arch=(x86_64 aarch64)
url=https://github.com/libretro/desmume
license=(GPL-2.0-only)
groups=(libretro)
depends=(
  libgl
  libretro-core-info
)
makedepends=(
  git
  libpcap
  mesa
)
source=(libretro-desmume::git+https://github.com/libretro/desmume.git#commit=${pkgver##*.g}
        desmume-arm64-build-fix.patch)
b2sums=('94722bd1adad0b0d966d4f506d1bc341f9e729f2fefa5235aef78a875314247657c8196a3c81069c4cdd7c57004af42fb04f1f03f133a9e01c3d8b2fd70b11a6'
        '49d6e542135d5a45707f7113e1dc26b0cf4ad898779dfe4b08a5a20e76e914511973dc0c5f65b433a455b6f40a654a4345edb6cb6984e430644494a2e9c35b57')

prepare() {
  cd libretro-desmume
  patch -Np1 -i ../desmume-arm64-build-fix.patch
}

build() {
  local make_options=()
  [[ $CARCH != aarch64 ]] || make_options+=(platform=arm64-unix)
  make -C libretro-desmume/desmume/src/frontend/libretro -f Makefile.libretro "${make_options[@]}"
}

package() {
  install -Dm 644 libretro-desmume/desmume/src/frontend/libretro/desmume_libretro.so -t "${pkgdir}"/usr/lib/libretro/
}

