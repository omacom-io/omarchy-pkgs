_install_cuda_service() {
  install -Dm644 "$srcdir/ollama-cuda.service" \
    "$pkgdir/usr/lib/systemd/system/ollama.service.d/01-cuda.conf"
  install -Dm644 "$srcdir/ollama-cuda.conf" "$pkgdir/etc/ollama-cuda.conf"
}

package_ollama() {
  pkgdesc='Ollama CPU runtime for ARM64'
  depends=('gcc-libs' 'glibc' 'libcap')
  optdepends=(
    'ollama-cuda: generic NVIDIA CUDA backend'
    'ollama-cuda-jetpack5: NVIDIA JetPack 5 backend'
    'ollama-cuda-jetpack6: NVIDIA JetPack 6 backend'
  )
  backup=('etc/ollama.conf')
  install=ollama.install

  install -Dm755 "$srcdir/bin/ollama" "$pkgdir/usr/bin/ollama"
  install -dm755 "$pkgdir/usr/lib/ollama"
  local item name
  for item in "$srcdir/lib/ollama/"*; do
    name=${item##*/}
    case "$name" in
      cuda_v12 | cuda_v13 | cuda_jetpack5 | cuda_jetpack6 | vulkan*) continue ;;
    esac
    cp -a "$item" "$pkgdir/usr/lib/ollama/"
  done

  install -Dm644 "$srcdir/ollama.service" "$pkgdir/usr/lib/systemd/system/ollama.service"
  install -Dm644 "$srcdir/ollama.conf" "$pkgdir/etc/ollama.conf"
  install -Dm644 "$srcdir/sysusers.conf" "$pkgdir/usr/lib/sysusers.d/ollama.conf"
  install -Dm644 "$srcdir/tmpfiles.d" "$pkgdir/usr/lib/tmpfiles.d/ollama.conf"
  install -Dm644 "$srcdir/LICENSE-${pkgver}" "$pkgdir/usr/share/licenses/ollama/LICENSE"
  install -Dm644 "$srcdir/README-${pkgver}.md" "$pkgdir/usr/share/doc/ollama/README.md"
}

package_ollama-cuda() {
  pkgdesc='Generic NVIDIA CUDA 12/13 backends for Ollama on ARM64'
  depends=("ollama=${pkgver}")
  optdepends=('nvidia-utils: NVIDIA userspace driver where available')
  conflicts=('ollama-cuda-jetpack5' 'ollama-cuda-jetpack6')
  backup=('etc/ollama-cuda.conf')

  install -dm755 "$pkgdir/usr/lib/ollama"
  cp -a "$srcdir/lib/ollama/cuda_v12" "$srcdir/lib/ollama/cuda_v13" \
    "$pkgdir/usr/lib/ollama/"
  _install_cuda_service
}

package_ollama-cuda-jetpack5() {
  pkgdesc='NVIDIA JetPack 5 CUDA backend for Ollama on ARM64'
  depends=("ollama=${pkgver}")
  conflicts=('ollama-cuda' 'ollama-cuda-jetpack6')
  backup=('etc/ollama-cuda.conf')

  install -dm755 "$pkgdir/usr/lib/ollama"
  cp -a "$srcdir/lib/ollama/cuda_jetpack5" "$pkgdir/usr/lib/ollama/"
  _install_cuda_service
}

package_ollama-cuda-jetpack6() {
  pkgdesc='NVIDIA JetPack 6 CUDA backend for Ollama on ARM64'
  depends=("ollama=${pkgver}")
  conflicts=('ollama-cuda' 'ollama-cuda-jetpack5')
  backup=('etc/ollama-cuda.conf')

  install -dm755 "$pkgdir/usr/lib/ollama"
  cp -a "$srcdir/lib/ollama/cuda_jetpack6" "$pkgdir/usr/lib/ollama/"
  _install_cuda_service
}
