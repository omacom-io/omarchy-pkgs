# Maintainer: David Heinemeier Hansson <david@hey.com>

pkgname=omacalc
pkgver=0.2.1
pkgrel=1
pkgdesc='Dead-simple calculator built with Qt Quick'
arch=('x86_64' 'aarch64')
url='https://github.com/omacom-io/omacalc'
license=('MIT' 'OFL-1.1')
install='omacalc.install'
options=('!debug')
depends=(
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-declarative'
  'xdg-desktop-portal'
)
makedepends=(
  'gcc'
  'make'
  'qt6-base'
  'qt6-declarative'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/omacom-io/omacalc/archive/refs/tags/v$pkgver.tar.gz"
        'omacalc.desktop'
        'omacalc.svg')
sha256sums=('2cfcad3ef6864b84a44ab21d06947aa8642d82b18050c9f9fd5564439bc0f011'
            'a8697a8606ab2ff6323e2923a835b1d3312e03f20614b71b1d5db57c84c93306'
            'a6366f7167e657dd3be9c129a533fccc007dfb644db505f07068ad5a5986d34d')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/omacalc "$pkgdir/usr/bin/omacalc"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  install -Dm644 "$srcdir/omacalc.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omacalc.svg"
  install -Dm644 "$srcdir/omacalc.desktop" "$pkgdir/usr/share/applications/omacalc.desktop"
}
