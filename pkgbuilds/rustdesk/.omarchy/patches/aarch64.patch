 _vcs=("${_vcs[@]##*/}")
 noextract=("${_vcs[@]}")
 
+# The AUR rustdesk-bin recipe uses RustDesk's official RPM on AArch64 because
+# the vendor only publishes its Arch package for x86_64. Keep the existing
+# source build unchanged on x86_64 and follow that established ARM packaging
+# path here.
+_arm_filename="rustdesk-${_pkgver}-0.aarch64.rpm"
+source_aarch64=("${_arm_filename}::${_giturl}/releases/download/${_pkgver}/${_arm_filename}")
+sha256sums_aarch64=('SKIP')
+
 if ! :; then
   _srcdir="${_pkgname}"
   source[0]="git+${_giturl}#tag=${_pkgver}"
@@ -329,7 +338,38 @@ for _fk in "${!source[@]}"; do
   fi
 done
 unset _fk
 
+# The AUR source build is x86_64-only here. Keeping these arrays architecture
+# scoped prevents the native ARM builder from fetching that large toolchain.
+depends_x86_64=("${depends[@]}")
+depends_aarch64=(
+  'gtk3'
+  'xdotool'
+  'libxcb'
+  'libxfixes'
+  'libpulse'
+  'libva'
+  'libvdpau'
+  'pam'
+  'gst-plugins-base'
+  'gst-plugin-pipewire'
+)
+optdepends_x86_64=("${optdepends[@]}")
+optdepends_aarch64=(
+  'libappindicator-gtk3: tray icon'
+  'libayatana-appindicator: tray icon'
+)
+source_x86_64=("${source[@]}")
+md5sums_x86_64=("${md5sums[@]}")
+sha256sums_x86_64=("${sha256sums[@]}")
+makedepends_x86_64=("${makedepends[@]}")
+depends=()
+optdepends=()
+source=()
+md5sums=()
+sha256sums=()
+makedepends=()
+
