+  [[ $CARCH != aarch64 ]] || return 0
+
   local -
   _dpr_check
   #rm -rf ~/'.cache/vcpkg/archives' ~/'.vcpkg'
@@ -566,6 +608,8 @@ EOF
 }
 
 build() {
+  [[ $CARCH != aarch64 ]] || return 0
+
   local -
   msg2 'Build vcpkg'
   set -u
@@ -623,6 +667,23 @@ check_disabled() {
 }
 
 package() {
+  if [[ $CARCH == aarch64 ]]; then
+    install -dm755 "$pkgdir/usr/share" "$pkgdir/usr/bin"
+    cp -r "$srcdir/usr/share/rustdesk" "$pkgdir/usr/share/"
+    cp -r "$srcdir/usr/share/icons" "$pkgdir/usr/share/"
+    ln -s /usr/share/rustdesk/rustdesk "$pkgdir/usr/bin/rustdesk"
+
+    install -Dm644 "$srcdir/usr/share/rustdesk/files/rustdesk.service" \
+      "$pkgdir/usr/lib/systemd/system/rustdesk.service"
+    install -Dm644 "$srcdir/usr/share/rustdesk/files/rustdesk.desktop" \
+      "$pkgdir/usr/share/applications/rustdesk.desktop"
+    install -Dm644 "$srcdir/usr/share/rustdesk/files/rustdesk-link.desktop" \
+      "$pkgdir/usr/share/applications/rustdesk-link.desktop"
+
+    rm -r "$pkgdir/usr/share/rustdesk/files"
+    return
+  fi
+
   local -
   set -u
   cd "${_srcdir}"
