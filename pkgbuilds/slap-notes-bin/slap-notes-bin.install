_sandbox_perms() {
  # Chromium needs the SUID sandbox helper only where unprivileged user
  # namespaces are unavailable; elsewhere it must stay non-SUID.
  if [ -e /opt/slap-notes/chrome-sandbox ]; then
    if { [ -L /proc/self/ns/user ] && unshare --user true; } >/dev/null 2>&1; then
      chmod 0755 /opt/slap-notes/chrome-sandbox || true
    else
      chmod 4755 /opt/slap-notes/chrome-sandbox || true
    fi
  fi
}

_apparmor_install() {
  local src=/opt/slap-notes/resources/apparmor-profile
  local dest=/etc/apparmor.d/slap-notes

  command -v apparmor_status >/dev/null 2>&1 || return 0
  apparmor_status --enabled >/dev/null 2>&1 || return 0
  [ -f "$src" ] || return 0

  # Only install a profile this AppArmor can actually parse.
  apparmor_parser --skip-kernel-load --debug "$src" >/dev/null 2>&1 || return 0
  install -Dm644 "$src" "$dest"

  if ! { [ -x /usr/bin/ischroot ] && /usr/bin/ischroot; }; then
    apparmor_parser --replace --write-cache --skip-read-cache "$dest" >/dev/null 2>&1 || true
  fi
}

post_install() {
  _sandbox_perms
  _apparmor_install

  cat <<'MSG'
  Slap Notes keeps your notes on this machine:
    ~/.config/slap-notes            app data (notes live here)
    ~/.config/slap-notes/workspace.json   plain-JSON copy of your vault

  The top bar auto-hides — move the cursor to the top edge to bring it back.
  Press Alt for the window menu.
MSG
}

post_upgrade() {
  _sandbox_perms
  _apparmor_install
}

post_remove() {
  local dest=/etc/apparmor.d/slap-notes
  if [ -f "$dest" ]; then
    if command -v apparmor_status >/dev/null 2>&1 && apparmor_status --enabled >/dev/null 2>&1; then
      if ! { [ -x /usr/bin/ischroot ] && /usr/bin/ischroot; }; then
        apparmor_parser --remove "$dest" >/dev/null 2>&1 || true
      fi
    fi
    rm -f "$dest"
  fi
}
