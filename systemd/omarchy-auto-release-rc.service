[Unit]
Description=Auto-release omarchy-pkgs for rc mirror
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Runs from the main checkout: bin/auto-release-rc creates and syncs the rc
# branch worktree itself, so a host with no rc branch yet is a no-op instead
# of a unit that fails every five minutes. Builds happen in the worktree but
# publish into the primary checkout's channel tree via OMARCHY_REPO_ROOT.
ExecStart=/bin/bash -c 'source /root/.omarchy/build-credentials && /root/omarchy-pkgs/bin/auto-release-rc'
Environment=OMARCHY_STATE_DIR=/root/.state
Environment=OMARCHY_REPO_ROOT=/root/omarchy-pkgs/pkgs.omarchy.org
TimeoutStartSec=7200

[Install]
WantedBy=multi-user.target
